<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="30dp"
    android:background="#1a1a1a">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nobiam Clicker"
        android:textSize="28sp"
        android:textColor="#00e5ff"
        android:textStyle="bold"
        android:layout_marginBottom="30dp"/>

    <TextView
        android:id="@+id/cpsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CPS: 10"
        android:textSize="20sp"
        android:textColor="#ffffff"
        android:layout_marginBottom="10dp"/>

    <SeekBar
        android:id="@+id/cpsSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="19"
        android:progress="9"/>

    <Button
        android:id="@+id/btnStartService"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Запустить кликер"
        android:textSize="18sp"
        android:backgroundTint="#00e5ff"
        android:textColor="#000000"
        android:layout_marginTop="30dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Нажмите кнопку, дайте разрешение,\nи плавающая кнопка появится поверх экрана"
        android:textColor="#888888"
        android:gravity="center"
        android:textSize="14sp"
        android:layout_marginTop="20dp"/>

</LinearLayout>
