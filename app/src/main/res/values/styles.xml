<resources>
    <color name="deep_abyss">#060C08</color>
    <color name="verdant_glass">#101A14</color>
    <color name="accent_emerald">#2ECC71</color>
    <color name="accent_turquoise">#1ABC9C</color>
    <color name="bioluminescence">#A3F7BF</color>
    <color name="text_primary">#ECF0F1</color>
    <color name="text_secondary">#A5B5A5</color>
    <color name="danger_red">#E74C3C</color>
    <color name="glass_border">#1E3B1E</color>

    <style name="GlassCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/verdant_glass</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">6dp</item>
        <item name="cardMaxElevation">10dp</item>
        <item name="strokeColor">@color/accent_emerald</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:alpha">0.95</item>
    </style>

    <style name="EmeraldButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/accent_emerald</item>
        <item name="rippleColor">@color/bioluminescence</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="GradientEmeraldButton" parent="Widget.Material3.Button">
        <item name="android:textColor">#FFFFFF</item>
        <item name="backgroundTint">@color/accent_emerald</item>
        <item name="rippleColor">@color/bioluminescence</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:elevation">8dp</item>
    </style>
</resources>
